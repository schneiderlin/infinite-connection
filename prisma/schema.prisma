// Prisma schema
// SQLite for local MVP; switch provider to "postgresql" when moving to production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String      @id @default(cuid())
  name          String?
  email         String      @unique
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  accountType   AccountType @default(PERSONAL)
  role          UserRole    @default(USER)
  bio           String?
  phone         String?
  wechat        String?
  interests     String[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  accounts      Account[]
  sessions      Session[]
  organization  Organization?
  contents      Content[]
  attachments   Attachment[]
  notifications Notification[]
  likes         Like[]
  helps         Help[]
  comments      Comment[]
}

enum AccountType {
  PERSONAL
  ORGANIZATION
}

enum UserRole {
  USER
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Organization {
  id                  String             @id @default(cuid())
  userId              String             @unique
  name                String
  shortName           String?
  category            String
  creditCode          String?            @unique
  legalRepresentative String?
  establishedAt       DateTime?
  contactName         String?
  contactPhone        String?
  registrationRegion  String?
  website             String?
  description         String?
  verificationStatus  VerificationStatus @default(PENDING)
  officialRating      String?
  certificateKey      String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ContentModule {
  UPDATE
  FUNDING
  JOB
  TOOL
}

enum ContentStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  UNPUBLISHED
  DELETED
}

model Content {
  id              String        @id @default(cuid())
  authorId        String
  module          ContentModule
  subtype         String
  title           String
  summary         String?
  body            String
  fields          String[]
  tags            String[]
  region          String?
  city            String?
  metadata        Json
  status          ContentStatus @default(DRAFT)
  rejectionReason String?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  publishedAt     DateTime?
  deletedAt       DateTime?
  likesCount      Int           @default(0)
  helpsCount      Int           @default(0)
  commentsCount   Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  attachments Attachment[]
  likes       Like[]
  helps       Help[]
  comments    Comment[]

  @@index([authorId, status])
  @@index([module, status, publishedAt])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([contentId])
}

model Help {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([contentId])
}

model Comment {
  id        String   @id @default(cuid())
  contentId String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([contentId, createdAt])
  @@index([authorId, createdAt])
}

model Attachment {
  id        String   @id @default(cuid())
  ownerId   String
  contentId String?
  objectKey String   @unique
  // 对象存储未配置时的临时兜底：保存压缩后的 data URL（仅用于过渡）。
  // 配置好 S3 后新图片会继续走 objectKey，历史内联图片仍可正常读取。
  dataUrl   String?
  fileName  String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())

  owner   User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  content Content? @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@index([contentId])
}

enum NotificationType {
  REVIEW_RESULT
  CONTACT_REQUEST
  VERIFICATION
  COMMENT
  SUBSCRIPTION
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

// The models below follow the Auth.js adapter schema so OAuth providers can be
// added later without a migration.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
